# ---- Supabase (Project Settings → API) ----
# Public: safe to expose to the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET: server-only. Never prefix with NEXT_PUBLIC_. Used by API routes only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
# Public base URL (used for QR join links). e.g. https://huntx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domain used to build internal login emails for username-based team accounts.
# Teams never see/receive mail on this; it only maps username -> Supabase Auth user.
TEAM_EMAIL_DOMAIN=teams.huntx.app
